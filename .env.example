# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=qwen/qwen3.8-27b

# Optional: long random string, set to the SAME value on the Cloudflare Pages project
# and the backend. Lets the backend trust the client IP forwarded by the proxy so
# rate limiting is per user instead of per proxy.
PROXY_SHARED_SECRET=
